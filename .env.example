# Public canonical URL used by Astro to generate absolute URLs and sitemap entries.
# Replace before a production build. Never put secrets in this file.
PUBLIC_SITE_URL=https://example.com

# Bind HTTP to localhost by default for local use or a host reverse proxy.
# Set 0.0.0.0 only when you explicitly intend to expose the container port publicly.
SITE_BIND=127.0.0.1
SITE_PORT=8080
