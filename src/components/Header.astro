---
import { site } from '../config/site';
const links = [
  { href: '/', label: '首页' },
  { href: '/services/', label: '服务与能力' },
  { href: '/projects/', label: '项目案例' },
  { href: '/about/', label: '关于我们' },
  { href: '/contact/', label: '联系我们' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.companyName}首页`}>
      {site.logo ? <img class="brand-logo" src={site.logo} alt="" /> : <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>}
      <span class="brand-name">{site.companyName}<small>{site.englishName}</small></span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="header-contact" href="/contact/">开始合作 <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu">
      <summary aria-label="打开导航菜单"><span></span><span></span><span></span></summary>
      <nav aria-label="移动端导航">
        {links.map((link) => <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}
      </nav>
    </details>
  </div>
</header>
