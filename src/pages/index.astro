---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, services, projects } from '../config/site';
---
<BaseLayout {...site.seo.home}>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow light"><span class="eyebrow-line"></span>{site.heroEyebrow}</p>
        <h1>{site.heroTitle[0]}<br /><em>{site.heroTitle[1]}</em></h1>
        <p class="hero-description">{site.heroDescription}</p>
        <div class="button-row"><a class="button button-accent" href="/contact/">{site.primaryCta}<span aria-hidden="true">↗</span></a><a class="button button-outline" href="/services/">{site.secondaryCta}<span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="hero-art-inner"><span class="art-label art-label-top">IDEAS INTO IMPACT</span><div class="art-glyph"><span></span><span></span><span></span><span></span></div><span class="art-label art-label-bottom">DESIGNED WITH PURPOSE / 001</span></div></div>
      <div class="hero-scroll">SCROLL TO EXPLORE <span>↓</span></div>
    </div>
  </section>

  <section class="intro-strip"><div class="container intro-strip-inner"><p>好的数字体验，<strong>始于对问题的深刻理解。</strong></p><span>STRATEGY / DESIGN / TECHNOLOGY</span></div></section>

  <section class="section services-section" id="services"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span>WHAT WE DO</p><h2>让技术成为<br /><em>向前的力量。</em></h2></div><p>从想法形成到持续运营，我们围绕真正重要的业务问题，提供清晰、可靠的数字解决方案。</p></div><div class="service-grid">{services.map((service) => <a class="service-card" href="/services/"><span class="service-number">{service.number} / {String(services.length).padStart(2, '0')}</span><div class="service-icon" aria-hidden="true"><span>↗</span></div><div><span class="card-overline">{service.category}</span><h3>{service.title}</h3><p>{service.summary}</p></div><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div><a class="text-link" href="/services/">探索全部服务 <span aria-hidden="true">↗</span></a></div></section>

  <section class="section project-section"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span>SELECTED CONCEPTS</p><h2>从构想到<br /><em>具体形态。</em></h2></div><p>以下均为虚构的概念案例，用于展示项目内容结构；请在真实发布前替换为获得授权的资料。</p></div><div class="project-grid">{projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}</div><a class="text-link" href="/projects/">查看所有演示案例 <span aria-hidden="true">↗</span></a></div></section>

  <section class="section approach-section"><div class="container approach-inner"><div><p class="eyebrow light"><span class="eyebrow-line"></span>OUR APPROACH</p><h2>把每一步，<br /><em>做得更明白。</em></h2><p class="approach-lead">值得信任的合作，来自清楚的问题、共同的目标和可见的进展。</p><a class="text-link light-link" href="/about/">了解我们的方式 <span aria-hidden="true">↗</span></a></div><div class="approach-list">{site.process.map((step) => <div class="approach-item"><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div><span aria-hidden="true">↗</span></div>)}</div></div></section>

  <section class="section cta-section"><div class="container cta-inner"><div><p class="eyebrow"><span class="eyebrow-line"></span>LET'S BUILD WHAT'S NEXT</p><h2>下一步，<em>一起开始。</em></h2><p>有一个想法，或有一个问题还没找到答案？从一次清晰的交流开始。</p></div><a class="button button-dark" href="/contact/">{site.primaryCta}<span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
